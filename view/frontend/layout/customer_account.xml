    "Sign-In Methods" in the account menu, after Account Information.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="zero-social-login-navigation-link"
                   ifconfig="zero_social_login/general/enabled">
                <arguments>
                    <argument name="label" xsi:type="string" translate="true">Sign-In Methods</argument>
                    <argument name="path" xsi:type="string">sociallogin/account</argument>
                    <argument name="sortOrder" xsi:type="number">175</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
