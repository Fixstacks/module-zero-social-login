<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template" name="zero.social.login.account"
                   template="Zero_SocialLogin::account.phtml" cacheable="false">
                <arguments>
                    <argument name="viewModel" xsi:type="object">Zero\SocialLogin\ViewModel\Account</argument>
                    <argument name="buttons" xsi:type="object">Zero\SocialLogin\ViewModel\Buttons</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
