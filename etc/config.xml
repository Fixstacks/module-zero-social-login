<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <zero_social_login>
            <general>
                <enabled>0</enabled>
            </general>
            <google>
                <enabled>0</enabled>
                <client_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
            </google>
            <apple>
                <enabled>0</enabled>
                <private_key backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
            </apple>
            <facebook>
                <enabled>0</enabled>
                <app_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
            </facebook>
        </zero_social_login>
    </default>
</config>
