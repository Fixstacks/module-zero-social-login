<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- The sign-in services, in button order. -->
    <type name="Zero\SocialLogin\Model\Provider\Pool">
        <arguments>
            <argument name="providers" xsi:type="array">
                <item name="google" xsi:type="object">Zero\SocialLogin\Model\Provider\Google</item>
                <item name="apple" xsi:type="object">Zero\SocialLogin\Model\Provider\Apple</item>
                <item name="facebook" xsi:type="object">Zero\SocialLogin\Model\Provider\Facebook</item>
            </argument>
        </arguments>
    </type>
</config>
